# Copy to .env.worker and populate only on the deployment host.
# Do not commit .env.worker or place secrets in image build arguments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VELTRIX_PUMPPORTAL_WS_ENDPOINT=wss://pumpportal.fun/api/data
VELTRIX_SOLANA_DISCOVERY_POLL_SECONDS=30
VELTRIX_MARKET_INTELLIGENCE_POLL_SECONDS=15
VELTRIX_MARKET_REFRESH_INTERVAL_MS=60000
VELTRIX_MARKET_BATCH_SIZE=25
VELTRIX_CONSENSUS_POLL_SECONDS=30
VELTRIX_CONSENSUS_REFRESH_INTERVAL_MS=60000
VELTRIX_CONSENSUS_BATCH_SIZE=10
VELTRIX_AGENT_HEARTBEAT_MAX_AGE_MS=300000
VELTRIX_WORKER_HEARTBEAT_MAX_AGE_MS=300000
VELTRIX_PROVIDER_PROBE_MAX_AGE_MS=300000
LIVE_TRADING=false
PAPER_TRADING_ENABLED=false
SCHEDULER_ENABLED=false
# Optional Helius evidence: keep blank/disabled unless a reviewed wallet allowlist is configured.
HELIUS_API_KEY=
TRUSTED_WALLET_PROVIDERS=
VELTRIX_TRUSTED_SOLANA_WALLETS=
