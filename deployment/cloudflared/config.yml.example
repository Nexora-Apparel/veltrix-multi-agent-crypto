# Copy to /etc/cloudflared/config.yml and replace both placeholders.
# The tunnel publishes only the loopback-bound authenticated Python API.
tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: api.example.com
    service: http://127.0.0.1:8765
  - service: http_status:404
