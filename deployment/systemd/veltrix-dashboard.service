[Unit]
Description=VELTRIX authenticated read-only analytics dashboard
After=network.target veltrix-pipeline.service
Wants=veltrix-pipeline.service

[Service]
Type=simple
User=veltrix-dashboard
Group=veltrix-db
SupplementaryGroups=veltrix-dashboard-secrets
WorkingDirectory=/opt/veltrix/app
EnvironmentFile=/etc/veltrix/dashboard.env
Environment=VELTRIX_DASHBOARD_HOST=127.0.0.1
Environment=VELTRIX_DASHBOARD_PORT=8765
Environment=VELTRIX_SOLANA_DISCOVERY_DB=/var/lib/veltrix/solana_discovery.sqlite3
ExecStart=/opt/veltrix/venv/bin/python -m veltrix.dashboard_server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/veltrix
InaccessiblePaths=/etc/veltrix/paper.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
