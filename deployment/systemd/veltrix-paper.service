[Unit]
Description=VELTRIX simulation-only paper trading runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veltrix-paper
Group=veltrix-db
SupplementaryGroups=veltrix-paper-secrets
WorkingDirectory=/opt/veltrix/app
EnvironmentFile=-/etc/veltrix/paper.env
Environment=LIVE_TRADING=false
Environment=PAPER_TRADING_ENABLED=true
Environment=VELTRIX_SOLANA_DISCOVERY_DB=/var/lib/veltrix/solana_discovery.sqlite3
UMask=0007
StateDirectory=veltrix
StateDirectoryMode=2770
ExecStart=/opt/veltrix/venv/bin/python -m veltrix.solana_meme.paper_runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/veltrix
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
