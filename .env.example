LIVE_TRADING=false
# Stage 1 release locks: keep disabled until all final release gates pass.
VELTRIX_DEPLOYMENT_TARGET=development
TELEGRAM_ENABLED=false
SCHEDULER_ENABLED=false
# Start the Phase 07 consensus-gated paper worker only when explicitly enabled.
PAPER_TRADING_ENABLED=false
PAPER_BALANCE_USD=500
MAX_POSITION_USD=50
MAX_OPEN_POSITIONS=10
STOP_LOSS_PCT=0.06
POLL_SECONDS=60
DB_PATH=veltrix_paper.db
# All Phase 03–07 stores and the existing PaperBroker must use this same file.
# If both DB_PATH and VELTRIX_SOLANA_DISCOVERY_DB are set, they must match.
VELTRIX_SOLANA_DISCOVERY_DB=veltrix_paper.db
# DexScreener latest token profiles are promotional/profile-driven, not a complete new-pair feed.
DISCOVERY_ENABLED=false
DISCOVERY_CHAINS=solana,base,bsc
MAX_DISCOVERED_PER_CHAIN=20
# Comma-separated contract addresses for additional explicit watchlists.
WATCHLIST_SOLANA=
WATCHLIST_BASE=
WATCHLIST_BSC=

# Read-only provider-readiness inventory is shown at startup; this is not a safety certification.

# Explicit provider allowlists. Leave empty until a provider has been vetted.
TRUSTED_WALLET_PROVIDERS=
TRUSTED_SAFETY_PROVIDERS=
# Composite Sniper gate: separate, vetted provider IDs for each evidence claim.
# The three lists must resolve to three distinct provider identities.
TRUSTED_LIQUIDITY_PROVIDERS=
TRUSTED_DEVELOPER_PROVIDERS=
TRUSTED_BUNDLE_PROVIDERS=
# Funding-trace sources must be separately vetted; never inherit generic trust.
TRUSTED_FUNDING_PROVIDERS=
# Launch-origin resolver identities are separately trusted from transaction indexers.
TRUSTED_LAUNCH_ORIGIN_PROVIDERS=
LAUNCH_INTELLIGENCE_ENABLED=false
# Maximum accepted age of external evidence (milliseconds).
WALLET_EVIDENCE_MAX_AGE_MS=300000
SAFETY_EVIDENCE_MAX_AGE_MS=300000

# Optional GoPlus Solana token-security API access token.
# Base (8453) and BSC (56) token security use the documented chain-ID endpoint.
GOPLUS_ACCESS_TOKEN=

# Helius read-only Solana transaction history. Keep the API key private.
HELIUS_API_KEY=
TRACKED_SMART_WALLETS=
# Optional Phase 06 override; otherwise TRACKED_SMART_WALLETS is used.
VELTRIX_TRUSTED_SOLANA_WALLETS=
VELTRIX_HELIUS_WALLET_SCAN_LIMIT=10
# Add "helius" to TRUSTED_WALLET_PROVIDERS only after vetting tracked wallets.
# Add "goplus" to TRUSTED_SAFETY_PROVIDERS only after reviewing provider coverage.

# Alchemy multichain EVM wallet transfers (Base + BNB Chain).
# Configure explicit quote-token contract allowlists; no stablecoin address is assumed.
ALCHEMY_API_KEY=
TRACKED_EVM_WALLETS=
ALCHEMY_QUOTE_TOKENS_BASE=
ALCHEMY_QUOTE_TOKENS_BSC=
# Dedicated historical JSON-RPC endpoints for launch indexing (keep URL/API keys private).
BASE_RPC_URL=
BSC_RPC_URL=
LAUNCH_WINDOW_MS=120000
LAUNCH_INDEX_MAX_PAGES=20
LAUNCH_BLOCK_CHUNK_SIZE=2000
FUNDING_LOOKBACK_BLOCKS=20000
# Add "alchemy" to TRUSTED_WALLET_PROVIDERS only after vetting tracked wallets.

# Optional live read-only provider acceptance probes (never submits transactions).
# Run with VELTRIX_RUN_LIVE_PROVIDER_ACCEPTANCE=true after setting credentials.
VELTRIX_RUN_LIVE_PROVIDER_ACCEPTANCE=false
INSIGHTX_API_KEY=
VELTRIX_ACCEPTANCE_SOLANA_TOKEN=
VELTRIX_ACCEPTANCE_BASE_TOKEN=
VELTRIX_ACCEPTANCE_BSC_TOKEN=

# Native holder inventory (read-only). Solana RPC URL may include a private API key.
SOLANA_RPC_URL=
# Public fee-payer/taker address for unsigned Jupiter order intake only.
# Never put private keys or signing material in this configuration.
JUPITER_TAKER_PUBLIC_KEY=FQtHmufHsELvyMHvQctu1kqZQ2zY8wDCJ4KpdxTQKb9U
HOLDER_INVENTORY_MAX_ACCOUNTS=50000
HOLDER_INVENTORY_MAX_LOGS=200000
HOLDER_INVENTORY_MAX_HOLDERS=50000

# Alchemy first-funder graph (Base only; BSC is excluded because internal
# transfer coverage is not documented there). No provider trust is implied.
FUNDING_GRAPH_MAX_PAGES=100
FUNDING_GRAPH_MAX_WALLETS=2000

# Independent identity attestations for developer/deployer root wallets
TRUSTED_DEVELOPER_ROOT_PROVIDERS=
FUNDING_GRAPH_MAX_TOTAL_PAGES=1000
TRUSTED_HOLDER_INVENTORY_PROVIDERS=
TRUSTED_DEVELOPER_FUNDING_PROVIDERS=

# Optional independent root-attestation service. Public key is Ed25519 raw bytes, base64 encoded.
DEVELOPER_ROOT_ATTESTATION_URL=
DEVELOPER_ROOT_ATTESTATION_PUBLIC_KEY=
DEVELOPER_ROOT_ATTESTATION_PROVIDER_ID=signed-developer-roots

# Finalized, read-only liquidity inventory. Use two independently operated RPC
# services per chain; the reader checks that both report the same finalized
# block hash / slot. Do not paste credentials into source control.
BASE_LIQUIDITY_POOL_RPC_URL=
BASE_LIQUIDITY_LOCKER_RPC_URL=
# JSON arrays of pinned factories and lockers. EVM runtime hashes are Keccak-256 of deployed bytecode, 64 hex chars without 0x.
# Factory entry: {"amm_id":"uniswap-v2","address":"0x...","deployment_block":123,"expected_code_hash":"<64-hex>"}
# Locker entry: {"amm_id":"uniswap-v2","address":"0x...","deployment_block":123,"expected_code_hash":"<64-hex>","abi_profile":"uncx-v2.1-locks-nonce"}
# Base V2.0-compatible candidate profile: "uncx-v2.0-locks-nonce"; confirm deployment/factory with UNCX first.
BASE_LIQUIDITY_AMM_FACTORIES_JSON=
BASE_UNCX_LOCKERS_JSON=
# Set true only after the factory list covers every AMM in the explicitly supported Base V2 scope.
BASE_LIQUIDITY_AMM_REGISTRY_COMPLETE=false

BSC_LIQUIDITY_POOL_RPC_URL=
BSC_LIQUIDITY_LOCKER_RPC_URL=
# BSC factory entry example uses amm_id "pancakeswap-v2".
# BSC locker entry uses abi_profile "uncx-v1-token-lock-index-events".
BSC_LIQUIDITY_AMM_FACTORIES_JSON=
BSC_UNCX_LOCKERS_JSON=
BSC_LIQUIDITY_AMM_REGISTRY_COMPLETE=false

# Solana pool inventory covers Raydium AMM V4 + CPMM. UNCX LP custody is
# verified for AMM V4 only; CPMM pools remain unverified and block the gate.
# CLMM, Meteora, Orca and PumpSwap remain outside the current supported scope.
SOLANA_LIQUIDITY_POOL_RPC_URL=
SOLANA_LIQUIDITY_LOCKER_RPC_URL=
# 64-character SHA-256 of the deployed Raydium AMM V4 ELF, independently pinned.
SOLANA_RAYDIUM_AMM_V4_EXECUTABLE_HASH=
# 64-character SHA-256 of the deployed Raydium CPMM ELF, independently pinned.
SOLANA_RAYDIUM_CPMM_EXECUTABLE_HASH=
SOLANA_LIQUIDITY_AMM_REGISTRY_COMPLETE=false

LIQUIDITY_READER_MAX_LOGS=200000
LIQUIDITY_READER_MAX_POOLS=50000
LIQUIDITY_READER_MAX_LOCKS=100000

# Do not add liquidity reader IDs to TRUSTED_LIQUIDITY_PROVIDERS until the
# manual "Liquidity live read-only acceptance" workflow passes on production.

# Phase 07 — consensus-gated simulation only; no exchange or wallet execution.
VELTRIX_PAPER_POLL_SECONDS=15
VELTRIX_PAPER_DECISION_BATCH_SIZE=25
VELTRIX_PAPER_FEE_BPS=100
VELTRIX_PAPER_SLIPPAGE_BPS=50
VELTRIX_PAPER_MAX_PORTFOLIO_EXPOSURE_PCT=0.5
VELTRIX_PAPER_MAX_DECISION_AGE_MS=120000
VELTRIX_PAPER_MAX_MARKET_AGE_MS=120000
VELTRIX_PAPER_MAX_RISK_AGE_MS=300000

# Read-only paper analytics dashboard; remote binds require a 32+ character token.
VELTRIX_DASHBOARD_HOST=127.0.0.1
VELTRIX_DASHBOARD_PORT=8765
VELTRIX_DASHBOARD_TOKEN=
VELTRIX_DASHBOARD_MARKET_MAX_AGE_MS=120000
